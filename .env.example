# GleeLounge — environment variables
# None are required for local dev or production; the defaults below are fine.

# Port the server listens on. Render injects this automatically.
# PORT=3001

# Directory for the SQLite file (games catalog + match history).
# Local default: ./data   ·   Render: /var/data (persistent disk)
# DATA_DIR=./data

# Only needed if/when Stripe Patron or Host Kit ship:
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_PATRON_ANNUAL=
# STRIPE_PRICE_PATRON_LIFETIME=
# STRIPE_PRICE_HOST_KIT=
# STRIPE_WEBHOOK_SECRET=
